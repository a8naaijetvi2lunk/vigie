{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigie",
  "version": "0.2.2",
  "identifier": "io.github.a8naaijetvi2lunk.vigie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vigie",
        "width": 320,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Vigie — Réglages",
        "width": 420,
        "height": 580,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "sessions",
        "title": "Vigie — Sessions",
        "width": 460,
        "height": 580,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/vigie/32x32.png",
      "icons/vigie/128x128.png",
      "icons/vigie/128x128@2x.png",
      "icons/vigie/icon.icns",
      "icons/vigie/icon.ico"
    ]
  }
}
